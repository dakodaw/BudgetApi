{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug BudgetApi",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Build BudgetApi",
      "program": "${workspaceFolder}/BudgetApi/bin/Debug/net10.0/BudgetApi.dll",
      "args": [],
      "cwd": "${workspaceFolder}/BudgetApi",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:5001;http://localhost:5000"
      }
    },
    {
      "name": "Attach to BudgetApi",
      "type": "coreclr",
      "request": "attach"
    }
  ]
}
